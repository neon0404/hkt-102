{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "skipLibCheck": true, "esModuleInterop": true, "types": ["node"], "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true, "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["core/**/*.ts", "worker/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
